# ============ 必填配置 ============
# Telegram 机器人 Token（从 @BotFather 获取，切勿提交到仓库）
BOT_TOKEN=

# 机器人用户名（不含 @，例如 YOUR_BOT_USERNAME）
BOT_USERNAME=YOUR_BOT_USERNAME

# 管理员 TGID，多个用英文逗号分隔（例如 123456789,987654321）
# 注意：管理员必须先给机器人发送过 /start，否则无法收到消息与指令
ADMIN_IDS=123456789

# ============ 可选配置 ============
# 生图请求超时秒数（默认 600）
# DRAW_TIMEOUT_SECONDS=600

# OkPay 异步回调 / 健康检查使用的 Web 端口（默认 5003）
# WEB_PORT=5003

# ============ 运行数据（不要提交） ============
# 数据库 image_bot.db、生成图片 generated_images/、克隆密钥 clone_secret.key
# 均自动生成在项目根目录，已写入 .gitignore
